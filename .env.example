# Wise sandbox API token — register at https://sandbox.transferwise.tech/
# and create a Personal Token (Settings -> API tokens) in your sandbox account.
WISE_API_TOKEN=
WISE_ENV=sandbox

# Revolut X credentials are NOT set here — fx-pulse reads them from the same
# config file the revolut-x-api CLI writes to (~/.config/revolut-x/config.json,
# or %APPDATA%\revolut-x\config.json on Windows). Run `revx auth setup` once
# and both tools share the same registered API key + Ed25519 keypair.
# Override the location with REVOLUTX_CONFIG_DIR if needed.

FXPULSE_DATABASE_URL=postgresql://fxpulse:fxpulse@localhost:5432/fxpulse
